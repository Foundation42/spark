.{
    .name = .spark,
    .version = "0.1.0",
    .fingerprint = 0x9d13cf2d9d3b2e2c, // Changing this has security and trust implications.
    .minimum_zig_version = "0.14.1",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "shaders",
        "vendor",
    },
    .dependencies = .{
        // Shared primitives every Foundation42 sibling agrees on. `jobs.zig`
        // lived here as a byte-identical copy in seven repos, which made one
        // concurrency bug seven bugs and made a process-wide job system
        // impossible to express: two copies of a file are two Zig types.
        .common = .{ .path = "../common" },
    },
}
